generator client {
  provider = "prisma-client-js"
  engineType = "client"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
enum Role {
  OWNER
  ADMIN
  MANAGER
  EMPLOYEE
  VIEWER
}
enum Plan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}
model User {
  id String @id @default(cuid())
  email String @unique
  name String
  passwordHash String
  createdAt DateTime @default(now())
  memberships Membership[]
}
model Organization {
  id String @id @default(cuid())
  name String
  slug String @unique
  plan Plan @default(STARTER)
  createdAt DateTime @default(now())
  memberships Membership[]
  audit AuditLog[]
  leads Lead[]
  transactions Transaction[]
  projects Project[]
  tasks Task[]
  employees AiEmployee[]
  workflows Workflow[]
}
model Membership {
  id String @id @default(cuid())
  userId String
  orgId String
  role Role @default(EMPLOYEE)
  user User @relation(fields:[userId], references:[id], onDelete: Cascade)
  org Organization @relation(fields:[orgId], references:[id], onDelete: Cascade)
  @@unique([userId, orgId])
}
model AuditLog {
  id String @id @default(cuid())
  orgId String
  actorId String?
  action String
  meta Json?
  createdAt DateTime @default(now())
  org Organization @relation(fields:[orgId], references:[id], onDelete: Cascade)
  @@index([orgId, createdAt])
}

model Lead {
  id String @id @default(cuid())
  orgId String
  name String
  email String?
  phone String?
  source String?
  status String @default("NEW")
  value Float @default(0)
  createdAt DateTime @default(now())
  org Organization @relation(fields:[orgId], references:[id], onDelete: Cascade)
  @@index([orgId, status])
}
model Transaction {
  id String @id @default(cuid())
  orgId String
  type String
  category String
  amount Float
  note String?
  createdAt DateTime @default(now())
  org Organization @relation(fields:[orgId], references:[id], onDelete: Cascade)
  @@index([orgId, createdAt])
}
model Project {
  id String @id @default(cuid())
  orgId String
  name String
  description String?
  status String @default("ACTIVE")
  createdAt DateTime @default(now())
  org Organization @relation(fields:[orgId], references:[id], onDelete: Cascade)
  tasks Task[]
}
model Task {
  id String @id @default(cuid())
  orgId String
  projectId String?
  title String
  status String @default("TODO")
  priority String @default("MEDIUM")
  due String?
  createdAt DateTime @default(now())
  org Organization @relation(fields:[orgId], references:[id], onDelete: Cascade)
  project Project? @relation(fields:[projectId], references:[id], onDelete: SetNull)
  @@index([orgId, status])
}

model AiEmployee {
  id String @id @default(cuid())
  orgId String
  catalogKey String?
  name String
  title String
  instructions String
  tools String[]
  status String @default("ACTIVE")
  createdAt DateTime @default(now())
  org Organization @relation(fields:[orgId], references:[id], onDelete: Cascade)
  messages AgentMessage[]
  @@index([orgId])
}
model AgentMessage {
  id String @id @default(cuid())
  orgId String
  employeeId String
  role String
  content String
  createdAt DateTime @default(now())
  employee AiEmployee @relation(fields:[employeeId], references:[id], onDelete: Cascade)
  @@index([employeeId, createdAt])
}

model Workflow {
  id String @id @default(cuid())
  orgId String
  name String
  trigger String
  active Boolean @default(false)
  nodes Json @default("[]")
  createdAt DateTime @default(now())
  org Organization @relation(fields:[orgId], references:[id], onDelete: Cascade)
  runs WorkflowRun[]
  @@index([orgId, trigger])
}
model WorkflowRun {
  id String @id @default(cuid())
  orgId String
  workflowId String
  status String @default("RUNNING")
  data Json @default("{}")
  log Json @default("[]")
  cursor Int @default(0)
  error String?
  createdAt DateTime @default(now())
  workflow Workflow @relation(fields:[workflowId], references:[id], onDelete: Cascade)
  @@index([orgId, createdAt])
}

model BrainMessage {
  id String @id @default(cuid())
  orgId String
  userId String
  role String
  content String
  createdAt DateTime @default(now())
  @@index([orgId, userId, createdAt])
}

model KbDoc {
  id String @id @default(cuid())
  orgId String
  title String
  content String
  createdAt DateTime @default(now())
  @@index([orgId])
}
model Notification {
  id String @id @default(cuid())
  orgId String
  type String
  message String
  read Boolean @default(false)
  createdAt DateTime @default(now())
  @@index([orgId, read, createdAt])
}
model UsageEvent {
  id String @id @default(cuid())
  orgId String
  kind String
  createdAt DateTime @default(now())
  @@index([orgId, kind, createdAt])
}
